## Frontend
## Optional. Leave blank to derive the API host from the browser origin.
NEXT_PUBLIC_API_URL=

## Backend application
APP_NAME=TrainUp API
API_PREFIX=/api
BACKEND_CORS_ORIGINS=["*"]

## Database
DATABASE_URL=postgresql://trainup_user:trainup_password@db:5432/trainup_db

## Auth
SECRET_KEY=change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

## Pose extraction and upload processing
POSE_TARGET_FPS=20
POSE_MAX_WIDTH=720
POSE_CACHE_ENABLED=true

## Advanced analysis feature flags
FUZZY_INTERPRETATION_ENABLED=true
IT2_FUZZY_ENABLED=true

## Gemini coaching refinement
## Deterministic feedback remains available when enhancement is disabled or unavailable.
LLM_ENABLE_ENHANCEMENT=true
LLM_ENABLED=
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=220
LLM_TEMPERATURE=0.2

## Kokoro TTS coaching playback
TTS_ENABLED=true
TTS_MODEL=hexgrad/Kokoro-82M
TTS_VOICE=am_michael
TTS_WARMUP_ON_STARTUP=true
TTS_SEGMENT_PAUSE_MS=400

## Cache/model hygiene
## Large local model files under backend/models are ignored by Git.
## Drill demo videos under frontend/public/videos/drills are intentionally tracked.
