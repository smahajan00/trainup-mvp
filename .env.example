## Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

## Backend
DATABASE_URL=postgresql://trainup_user:trainup_password@db:5432/trainup_db
SECRET_KEY=change_this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

## Optional LLM enhancement
## Deterministic feedback works without these values. If enhancement is disabled
## or the provider is unavailable, the backend returns deterministic fallback
## feedback and marks the LLM result with fallback_used=true.
LLM_ENABLE_ENHANCEMENT=false
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
## Optional OpenAI-compatible base URL, for example http://localhost:11434/v1
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=10
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.2

## Optional fuzzy interpretation layer
FUZZY_INTERPRETATION_ENABLED=true
IT2_FUZZY_ENABLED=true
